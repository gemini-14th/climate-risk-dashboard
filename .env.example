# ── server/.env (local development) ──────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Local MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_password
DB_NAME=climate_dashboard

